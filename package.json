{
  "name": "multi-mine-host",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-Mine Host - dezentrales Minecraft-Hosting fuer Freundesgruppen",
  "author": "rara-blip99",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "hub": "tsx hub/main.ts",
    "dist": "npm run build && electron-builder --win --publish never",
    "lint": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/autonat": "^3.0.32",
    "@libp2p/bootstrap": "^12.0.36",
    "@libp2p/circuit-relay-v2": "^4.2.17",
    "@libp2p/identify": "^4.1.18",
    "@libp2p/peer-id": "^6.0.18",
    "@libp2p/ping": "^3.1.17",
    "@libp2p/tcp": "^11.0.32",
    "@libp2p/websockets": "^10.1.25",
    "@multiformats/multiaddr": "^13.0.3",
    "libp2p": "^3.5.1",
    "tar": "^7.4.3",
    "uint8arraylist": "^3.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "dev.multimine.host",
    "productName": "Multi-Mine Host",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
